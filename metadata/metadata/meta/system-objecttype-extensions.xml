<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">

    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="coveoOrganizationId">
                <display-name xml:lang="x-default">Coveo Organization Id</display-name>
                <description xml:lang="x-default">Coveo organization id used to build Stream API requests</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="coveoSourceId">
                <display-name xml:lang="x-default">Coveo Source ID</display-name>
                <description xml:lang="x-default">Legacy single-target Coveo source id used when no export targets are configured</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="coveoCatalogLastSync">
                <display-name xml:lang="x-default">Coveo Catalog Last Sync</display-name>
                <description xml:lang="x-default">Legacy single-target last sync used when no export targets are configured</description>
                <type>datetime</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="coveoProductImagePlaceholderUrl">
                <display-name xml:lang="x-default">Coveo Product Image Placeholder URL</display-name>
                <description xml:lang="x-default">Absolute fallback image URL used when the export cannot find product gallery images</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="coveoProductThumbnailPlaceholderUrl">
                <display-name xml:lang="x-default">Coveo Product Thumbnail Placeholder URL</display-name>
                <description xml:lang="x-default">Absolute fallback thumbnail URL used when the export cannot find product thumbnails. Falls back to the main image placeholder when empty.</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="coveoProductImageViewTypes">
                <display-name xml:lang="x-default">Coveo Product Image View Types</display-name>
                <description xml:lang="x-default">Ordered comma-separated SFCC image view types to try for ec_images, for example large,medium,original</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
            <attribute-definition attribute-id="coveoProductThumbnailViewTypes">
                <display-name xml:lang="x-default">Coveo Product Thumbnail View Types</display-name>
                <description xml:lang="x-default">Ordered comma-separated SFCC image view types to try for ec_thumbnails, for example medium,large,original</description>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
                <min-length>0</min-length>
            </attribute-definition>
        </custom-attribute-definitions>
        <group-definitions>
            <attribute-group group-id="Coveo Configs">
                <display-name xml:lang="x-default">Coveo Catalog Ingestion</display-name>
                <attribute attribute-id="coveoOrganizationId"/>
                <attribute attribute-id="coveoSourceId"/>
                <attribute attribute-id="coveoCatalogLastSync"/>
                <attribute attribute-id="coveoProductImagePlaceholderUrl"/>
                <attribute attribute-id="coveoProductThumbnailPlaceholderUrl"/>
                <attribute attribute-id="coveoProductImageViewTypes"/>
                <attribute attribute-id="coveoProductThumbnailViewTypes"/>
            </attribute-group>
        </group-definitions>
    </type-extension>
    <type-extension type-id="TrackingRef"/>

</metadata>
