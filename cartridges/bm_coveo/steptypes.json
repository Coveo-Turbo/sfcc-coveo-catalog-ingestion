{
    "step-types": {
      "script-module-step": [
        {
          "@type-id":"custom.coveo.coveoFieldMappingImport",
          "@supports-organization-context": false,
          "description": "Imports a Coveo field mapping profile and mapping rows from a JSON file in IMPEX",
          "module": "bm_coveo/cartridge/scripts/jobs/importFieldMappings.js",
          "function":"execute",
          "parameters": {
            "parameter": [
              {
                "@name": "sourceFile",
                "@type": "string",
                "@required": "true",
                "@trim": "true",
                "description": "Source JSON file path (in IMPEX) that defines the field mapping profile and rows"
              },
              {
                "@name": "replaceExistingMappings",
                "description": "Remove existing mappings for the same profile and site when they are not present in the JSON file",
                "@type": "boolean",
                "@required": "false",
                "@trim": "true",
                "default-value": false
              }
            ]
          },
          "status-codes": {
            "status": [
              {
                "@code": "ERROR",
                "description": "Used when an error occurred."
              },
              {
                "@code": "OK",
                "description": "Used when everything went well."
              }
            ]
          }
        },
        {
          "@type-id":"custom.coveo.coveoCatalogAttributeAudit",
          "@supports-organization-context": false,
          "description": "Audits a catalog in a selected locale and writes populated product and category attribute reports to IMPEX",
          "module": "bm_coveo/cartridge/scripts/jobs/auditCatalogAttributes.js",
          "function":"execute",
          "parameters": {
            "parameter": [
              {
                "@name": "catalogId",
                "@type": "string",
                "@required": "true",
                "@trim": "true",
                "description": "Catalog id to audit, for example mondou_CA-storefront"
              },
              {
                "@name": "locale",
                "@type": "string",
                "@required": "false",
                "@trim": "true",
                "description": "Optional locale to apply while reading localizable product and category attributes, for example en_CA or fr_CA"
              },
              {
                "@name": "outputPath",
                "@type": "string",
                "@required": "false",
                "@trim": "true",
                "description": "Output folder path (in IMPEX) for the generated JSON and CSV reports",
                "default-value": "/src/coveo/reports/catalog-attributes/"
              },
              {
                "@name": "sampleLimit",
                "@type": "long",
                "@required": "false",
                "@trim": "true",
                "description": "Maximum number of unique sample values to keep per attribute",
                "default-value": 5
              },
              {
                "@name": "maxProducts",
                "@type": "long",
                "@required": "false",
                "@trim": "true",
                "description": "Optional maximum number of catalog products to scan. Use 0 to scan the full catalog",
                "default-value": 0
              }
            ]
          },
          "status-codes": {
            "status": [
              {
                "@code": "ERROR",
                "description": "Used when an error occurred."
              },
              {
                "@code": "OK",
                "description": "Used when everything went well."
              }
            ]
          }
        },
        {
          "@type-id":"custom.coveo.coveoPlatformFieldCreate",
          "@supports-organization-context": false,
          "description": "Creates missing Coveo platform fields from the same JSON file used for SFCC field mapping imports",
          "module": "bm_coveo/cartridge/scripts/jobs/createPlatformFields.js",
          "function":"execute",
          "parameters": {
            "parameter": [
              {
                "@name": "sourceFile",
                "@type": "string",
                "@required": "true",
                "@trim": "true",
                "description": "Source JSON file path (in IMPEX) that defines the field mapping profile, rows, and optional coveoField settings"
              }
            ]
          },
          "status-codes": {
            "status": [
              {
                "@code": "ERROR",
                "description": "Used when an error occurred."
              },
              {
                "@code": "OK",
                "description": "Used when everything went well."
              }
            ]
          }
        },
        {
          "@type-id":"custom.coveo.coveoListingPagesSync",
          "@supports-site-context": true,
          "@supports-organization-context": false,
          "description": "Creates or updates Coveo Merchandising Hub listing pages from SFCC categories and brands",
          "module": "bm_coveo/cartridge/scripts/jobs/syncListingPages.js",
          "function": "execute",
          "parameters": {
            "parameter": [
              {
                "@name": "targetId",
                "@type": "string",
                "@required": "false",
                "@trim": "true",
                "description": "Optional export target id for multi-locale or catalog-scoped listing page sync"
              },
              {
                "@name": "dryRun",
                "@type": "boolean",
                "@required": "false",
                "@trim": "true",
                "default-value": false,
                "description": "When true, calculates create/update counts without writing to CMH"
              },
              {
                "@name": "existingTrackingIds",
                "@type": "string",
                "@required": "false",
                "@trim": "true",
                "description": "Optional comma-separated legacy tracking ids to include when reading existing pages"
              },
              {
                "@name": "excludedCategoryRoots",
                "@type": "string",
                "@required": "false",
                "@trim": "true",
                "default-value": "products",
                "description": "Optional comma-separated root category IDs or names excluded from generated category listing pages"
              }
            ]
          },
          "status-codes": {
            "status": [
              {
                "@code": "ERROR",
                "description": "Used when an error occurred."
              },
              {
                "@code": "OK",
                "description": "Used when everything went well."
              }
            ]
          }
        }
      ],
      "chunk-script-module-step": [
        {
          "@type-id":"custom.coveo.coveoProductExportFull",
          "@supports-organization-context": false,
          "description": "Performs a full Coveo catalog reconcile using Stream update operations",
          "module": "bm_coveo/cartridge/scripts/jobs/exportProducts.js",
          "before-step-function":"beforeStep",
          "read-function":"read",
          "process-function":"process",
          "write-function":"write",
          "after-step-function":"afterStep",
          "after-chunk-function":"afterChunk",
          "chunk-size": 1000,
          "parameters": {
            "parameter": [{
                          "@name": "srcFolder",
                          "@type": "string",
                          "@required": "true",
                          "@trim": "true",
                          "description": "Source folder path (in IMPEX) to export the file",
                          "default-value": "/src/coveo/feeds/products/"
                      },
                      {
                        "@name": "archivePath",
                        "@type": "string",
                        "@required": "true",
                        "@trim": "true",
                        "description": "Local path to archive file after successfully upload to server"
                      },
                      {
                        "@name": "deleteFile",
                        "description": "Delete file after sucessfull upload to coveo",
                        "@type": "boolean",
                        "@required": "false",
                        "@trim": "true",
                        "default-value": true
                      },
                      {
                        "@name": "targetId",
                        "@type": "string",
                        "@required": "false",
                        "@trim": "true",
                        "description": "Optional export target id for multi-locale or catalog-scoped exports"
                      }
            ]
          },
          "status-codes": {
            "status": [
              {
                "@code": "ERROR",
                "description": "Used when an error occurred."
              },
              {
                "@code": "OK",
                "description": "Used when everything went well."
              }
            ]
          }
        },
        {
          "@type-id":"custom.coveo.coveoProductExportDelta",
          "@supports-organization-context": false,
          "description": "Exports products changed since the last successful Coveo catalog sync",
          "module": "bm_coveo/cartridge/scripts/jobs/exportProductsDelta.js",
          "before-step-function":"beforeStep",
          "read-function":"read",
          "process-function":"process",
          "write-function":"write",
          "after-step-function":"afterStep",
          "parameters": {
            "parameter": [{
                          "@name": "srcFolder",
                          "@type": "string",
                          "@required": "true",
                          "@trim": "true",
                          "description": "Source folder path (in IMPEX) to export the file",
                          "default-value": "/src/coveo/feeds/products/"
                      },
                      {
                        "@name": "archivePath",
                        "@type": "string",
                        "@required": "true",
                        "@trim": "true",
                        "description": "Local path to archive file after successfully upload to server"
                      },
                      {
                        "@name": "deleteFile",
                        "description": "Delete file after sucessfull upload to coveo",
                        "@type": "boolean",
                        "@required": "false",
                        "@trim": "true",
                        "default-value": true
                      },
                      {
                        "@name": "targetId",
                        "@type": "string",
                        "@required": "false",
                        "@trim": "true",
                        "description": "Optional export target id for multi-locale or catalog-scoped exports"
                      }
            ]
          },
          "status-codes": {
            "status": [
              {
                "@code": "ERROR",
                "description": "Used when an error occurred."
              },
              {
                "@code": "OK",
                "description": "Used when everything went well."
              }
            ]
          }
        }
      ]
    }
  }
  
